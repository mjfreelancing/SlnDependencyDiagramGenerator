<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <LangVersion>Latest</LangVersion>
        <Nullable>enable</Nullable>
        <Version>3.0.0</Version>
        <Description>This package contains a Visual Studio Dependency Generator.</Description>
        <Authors>Malcolm Smith</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/mjfreelancing/SlnDependencyDiagramGenerator</RepositoryUrl>
        <PackageIcon>package_icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!--Stop warning related to end-of-life .NET versions-->
        <CheckEolTargetFramework>false</CheckEolTargetFramework>
        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>

        <!-- devblogs.microsoft.com/dotnet/producing-packages-with-source-link/ -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <DebugType>embedded</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AllOverIt" Version="9.2.1" />
        <PackageReference Include="AllOverIt.Validation" Version="9.2.1" />
        <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />

        <!--
            MSBuildLocator loads a compatible MSBuild toolset at runtime.
            - ExcludeAssets="runtime" prevents NuGet.Frameworks runtime binaries from being copied into this app output where they can conflict with the located MSBuild assemblies.
            - PrivateAssets="all" keeps this package as an implementation detail so it does not flow transitively to consumers of this library.
        -->
        <PackageReference Include="NuGet.Frameworks" Version="7.6.0" ExcludeAssets="runtime" PrivateAssets="all" />

        <PackageReference Include="NuGet.ProjectModel" Version="7.6.0" />
        <PackageReference Include="NuGet.Protocol" Version="7.6.0" />
        <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.300" PrivateAssets="All" />
    </ItemGroup>

    <!--
        Same runtime-asset rule for Microsoft.Build: compile against the package, but do not
        copy runtime MSBuild binaries. Runtime loading is handled by MSBuildLocator.
    -->
    
    <ItemGroup Condition=" '$(TargetFramework)' == 'net8.0' or '$(TargetFramework)' == 'net9.0' ">
        <PackageReference Include="Microsoft.Build" Version="17.11.4" ExcludeAssets="runtime" />
    </ItemGroup>

    <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
        <PackageReference Include="Microsoft.Build" Version="18.6.3" ExcludeAssets="runtime" />
    </ItemGroup>

    <ItemGroup>
        <None Include="package_icon.png">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <None Include="..\README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Renderers\D2\" />
      <Folder Include="Renderers\Mermaid\" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SlnDependencyDiagramGenerator.Tests.Unit" />
        <InternalsVisibleTo Include="SlnDependencyDiagramGenerator.Tests.Integration" />
    </ItemGroup>
</Project>
