<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Test fixture with deliberate package versions — vulnerabilities not exploitable.
         NU1605 (downgrade) is intentionally suppressed: LibV2 pins Newtonsoft.Json at [12.0.3]
         while RestSharp.Serializers.NewtonsoftJson 108.x requires >= 13.0.1, so NuGet resolves
         12.0.3 and the transitive edge is genuinely OUT of range (drift). -->
    <NoWarn>NU1605;NU1902;NU1903</NoWarn>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Drives IsRequestedDifferentVersion -> true end-to-end: LibV2 pins Newtonsoft.Json at
         [12.0.3], but RestSharp.Serializers.NewtonsoftJson 108.x depends on Newtonsoft.Json
         >= 13.0.1, so the resolved 12.0.3 is OUTSIDE that transitive range. LibV2's 12.0.3 also
         differs from LibV1's 13.0.1, so the cross-project conflict section appears and the drift
         is surfaced. Restored by FixtureRestorer like every other fixture. -->
    <PackageReference Include="Newtonsoft.Json" Version="[12.0.3]" />
    <PackageReference Include="RestSharp.Serializers.NewtonsoftJson" Version="108.0.3" />
  </ItemGroup>

</Project>
