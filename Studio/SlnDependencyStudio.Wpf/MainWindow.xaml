<reactiveui:ReactiveWindow
    x:Class="SlnDependencyStudio.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:viewModels="clr-namespace:SlnDependencyStudio.Wpf"
    Title="SlnDependencyStudio"
    Width="1200"
    Height="800"
    MinWidth="900"
    MinHeight="600"
    x:TypeArguments="viewModels:MainWindowViewModel"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid Background="{DynamicResource MaterialDesignBackground}">
        <Grid.ColumnDefinitions>
            <!-- Left navigation -->
            <ColumnDefinition Width="220" />
            <!-- Centre workspace -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <!-- Workspace row (star-sized) -->
            <RowDefinition Height="*" />
            <!-- Bottom output panel (collapsible splitter) -->
            <RowDefinition Height="5" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>

        <!-- Left navigation placeholder -->
        <Border
            Grid.Column="0"
            Grid.Row="0"
            Grid.RowSpan="3"
            Background="{DynamicResource MaterialDesignPaper}"
            BorderBrush="{DynamicResource MaterialDesignDivider}"
            BorderThickness="0,0,1,0">
            <StackPanel Margin="12">
                <TextBlock
                    Text="Navigation"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Margin="0,8,0,12" />
                <TextBlock
                    Text="(Phase 1 placeholder)"
                    Foreground="{DynamicResource MaterialDesignHintForeground}"
                    FontSize="12" />
            </StackPanel>
        </Border>

        <!-- Centre workspace placeholder -->
        <Border
            Grid.Column="1"
            Grid.Row="0"
            Background="{DynamicResource MaterialDesignBackground}"
            Padding="16">
            <TextBlock
                Text="Workspace"
                FontSize="18"
                Foreground="{DynamicResource MaterialDesignHintForeground}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Border>

        <!-- Output panel splitter (placeholder, non-functional in Phase 1) -->
        <GridSplitter
            Grid.Column="1"
            Grid.Row="1"
            Height="5"
            HorizontalAlignment="Stretch"
            Background="{DynamicResource MaterialDesignDivider}"
            ResizeDirection="Rows"
            ResizeBehavior="PreviousAndNext" />

        <!-- Bottom output panel placeholder -->
        <Border
            Grid.Column="1"
            Grid.Row="2"
            Background="{DynamicResource MaterialDesignPaper}"
            BorderBrush="{DynamicResource MaterialDesignDivider}"
            BorderThickness="0,1,0,0"
            Padding="12">
            <TextBlock
                Text="Output"
                FontSize="12"
                Foreground="{DynamicResource MaterialDesignHintForeground}" />
        </Border>
    </Grid>

</reactiveui:ReactiveWindow>
