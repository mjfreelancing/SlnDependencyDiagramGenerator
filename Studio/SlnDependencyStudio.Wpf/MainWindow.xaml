<reactiveui:ReactiveWindow
    x:Class="SlnDependencyStudio.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:viewModels="clr-namespace:SlnDependencyStudio.Wpf.ViewModels"
    xmlns:wpf="clr-namespace:SlnDependencyStudio.Wpf"
    Title="SlnDependencyStudio"
    Width="1200"
    Height="800"
    MinWidth="900"
    MinHeight="600"
    x:TypeArguments="wpf:MainWindowViewModel"
    WindowStartupLocation="CenterScreen"
    Style="{StaticResource MaterialDesignWindow}"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Background="{DynamicResource MaterialDesignBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ====== LEFT NAVIGATION ====== -->

        <Border
            Grid.Column="0"
            Background="{DynamicResource MaterialDesignPaper}"
            BorderBrush="{DynamicResource MaterialDesignDivider}"
            BorderThickness="0,0,1,0">

            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button
                        x:Name="SettingsButton"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="8,4"
                        Padding="8,6">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cog" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Settings" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <StackPanel Orientation="Horizontal" Margin="16,4,16,8">
                        <Ellipse Width="8" Height="8" Fill="Gray" Margin="0,0,6,0" ToolTip="d2 — not yet checked" />
                        <TextBlock Text="d2" FontSize="11" Foreground="{DynamicResource MaterialDesignHintForeground}" Margin="0,0,12,0" />
                        <Ellipse Width="8" Height="8" Fill="Gray" Margin="0,0,6,0" ToolTip="mmdc — not yet checked" />
                        <TextBlock Text="mmdc" FontSize="11" Foreground="{DynamicResource MaterialDesignHintForeground}" />
                    </StackPanel>
                </StackPanel>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Text="🧩 SlnDependencyStudio"
                        FontSize="12"
                        Foreground="{DynamicResource MaterialDesignHintForeground}"
                        Margin="16,12,16,8"
                        TextTrimming="CharacterEllipsis" />

                    <ListBox
                        x:Name="NavigationListBox"
                        Grid.Row="1"
                        ItemsSource="{Binding NavigationItems}"
                        SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                        Background="Transparent"
                        BorderThickness="0"
                        SelectionMode="Single"
                        HorizontalContentAlignment="Stretch"
                        Padding="0,4,0,4">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border
                                                x:Name="ItemBorder"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="4,0,0,0"
                                                Padding="12,10,12,10">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource MaterialDesignPrimary}" />
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MaterialDesignSelection}" />
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True" />
                                                        <Condition Property="IsSelected" Value="False" />
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MaterialDesignDivider}" />
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:NavigationItemViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Kind="{Binding IconKind}"
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0" />

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding DisplayName}"
                                        FontSize="13"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />

                                    <Ellipse
                                        Grid.Column="2"
                                        Width="8"
                                        Height="8"
                                        Fill="Red"
                                        Margin="6,0,0,0"
                                        ToolTip="This section has validation errors"
                                        Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVis}}" />

                                    <materialDesign:Chip
                                        Grid.Column="3"
                                        Content="opt"
                                        Style="{StaticResource MaterialDesignChip}"
                                        FontSize="9"
                                        Height="18"
                                        Padding="4,0"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding IsAdvanced, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ====== CENTRE WORKSPACE ====== -->

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="4*" MinHeight="60" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" MinHeight="60" />
            </Grid.RowDefinitions>

            <ContentControl
                Grid.Row="0"
                Content="{Binding CurrentPage}"
                Background="{DynamicResource MaterialDesignBackground}"
                Padding="16" />

            <GridSplitter
                Grid.Row="1"
                Height="5"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource MaterialDesignDivider}"
                ResizeDirection="Rows"
                ResizeBehavior="PreviousAndNext" />

            <Border
                Grid.Row="2"
                Background="{DynamicResource MaterialDesignPaper}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,1,0,0"
                Padding="12">
                <TextBlock
                    Text="Output"
                    FontSize="12"
                    Foreground="{DynamicResource MaterialDesignHintForeground}" />
            </Border>
        </Grid>
    </Grid>

</reactiveui:ReactiveWindow>
