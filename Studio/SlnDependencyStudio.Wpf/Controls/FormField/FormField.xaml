<UserControl
    x:Class="SlnDependencyStudio.Wpf.Controls.FormField"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="FormFieldRoot"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Label  -->
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,0,12,0"
            VerticalAlignment="{Binding LabelVerticalAlignment, ElementName=FormFieldRoot}"
            FontSize="14"
            FontWeight="Bold"
            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
            Text="{Binding Label, ElementName=FormFieldRoot}" />

        <!--  Content (input control) — bound to InputContent, not the inherited Content  -->
        <ContentControl
            Grid.Row="0"
            Grid.Column="1"
            VerticalAlignment="{Binding LabelVerticalAlignment, ElementName=FormFieldRoot}"
            Content="{Binding InputContent, ElementName=FormFieldRoot}"
            Focusable="False" />

        <!--  Separator  -->
        <Rectangle
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Height="1"
            Margin="0,8,0,8"
            Fill="{DynamicResource MaterialDesign.Brush.Separator.Background}" />

        <!--  Validation Error  -->
        <TextBlock
            Grid.Row="2"
            Grid.Column="1"
            Margin="0,0,0,8"
            FontSize="12"
            Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
            Text="{Binding ValidationError, ElementName=FormFieldRoot, TargetNullValue=''}"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
