<views:DialogBase
    x:Class="SlnDependencyStudio.Wpf.Views.RelativePathsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:SlnDependencyStudio.Wpf.Enumerations"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:SlnDependencyStudio.Wpf.Views"
    d:DesignWidth="420"
    mc:Ignorable="d">

    <materialDesign:Card
        MaxWidth="480"
        Margin="24"
        Padding="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Semantic accent strip  -->
            <Border
                x:Name="AccentStrip"
                Grid.Column="0"
                Background="{DynamicResource MaterialDesign.Brush.Primary}" />

            <!--  Content  -->
            <StackPanel Grid.Column="1" Margin="24,20,24,20">

                <!--  Header  -->
                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                    <!--  Tinted circle icon  -->
                    <Grid Margin="0,0,16,0" VerticalAlignment="Top">
                        <Ellipse
                            x:Name="IconBackground"
                            Width="44"
                            Height="44"
                            Fill="{DynamicResource MaterialDesign.Brush.Primary}"
                            Opacity="0.12" />
                        <materialDesign:PackIcon
                            x:Name="IconControl"
                            Width="24"
                            Height="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="AlertOutline" />
                    </Grid>

                    <TextBlock
                        x:Name="TitleText"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                        Text="Relative paths would break"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!--  Message body  -->
                <TextBlock
                    x:Name="MessageText"
                    Margin="0,4,0,0"
                    FontSize="14"
                    Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                    LineHeight="22"
                    TextWrapping="Wrap"
                    Text="These paths are stored relative to the project file, so they resolve against the folder the project is saved in. Saving to a different folder would make them point at the wrong location." />

                <!--  Affected paths  -->
                <Border
                    Margin="0,12,0,0"
                    Padding="12,10"
                    CornerRadius="4"
                    Background="{DynamicResource MaterialDesign.Brush.Separator.Background}">
                    <ScrollViewer
                        MaxHeight="200"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="RelativePathsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                            Text="{Binding Label}" />
                                        <TextBlock
                                            Margin="0,1,0,0"
                                            FontFamily="Cascadia Mono, Consolas"
                                            FontSize="13"
                                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                            Text="{Binding Path}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!--  Footer separator  -->
                <Border
                    Height="1"
                    Margin="0,20,0,16"
                    Background="{DynamicResource MaterialDesign.Brush.Separator.Background}" />

                <!--  Actions  -->
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">

                    <!--  Primary / default: re-base preserves portability  -->
                    <Button
                        Margin="0,0,8,0"
                        IsDefault="True"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        CommandParameter="{x:Static enums:SaveAsRelativePathAction.RebaseRelative}"
                        Content="Re-base Relative"
                        Style="{StaticResource MaterialDesignFlatButton}" />

                    <Button
                        Margin="0,0,8,0"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        CommandParameter="{x:Static enums:SaveAsRelativePathAction.ConvertToAbsolute}"
                        Content="Convert to Absolute"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />

                    <Button
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        CommandParameter="{x:Static enums:SaveAsRelativePathAction.Cancel}"
                        Content="Cancel"
                        IsCancel="True" />
                </StackPanel>

            </StackPanel>
        </Grid>
    </materialDesign:Card>
</views:DialogBase>
