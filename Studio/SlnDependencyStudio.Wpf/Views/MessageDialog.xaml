<views:DialogBase
    x:Class="SlnDependencyStudio.Wpf.Views.MessageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:SlnDependencyStudio.Wpf.Views"
    d:DesignWidth="420"
    mc:Ignorable="d">

    <materialDesign:Card
        MaxWidth="480"
        Margin="24"
        Padding="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Semantic accent strip  -->
            <Border
                x:Name="AccentStrip"
                Grid.Column="0"
                Background="{DynamicResource MaterialDesign.Brush.Primary}" />

            <!--  Content  -->
            <StackPanel Grid.Column="1" Margin="24,20,24,20">

                <!--  Header  -->
                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                    <!--  Tinted circle icon  -->
                    <Grid Margin="0,0,16,0" VerticalAlignment="Top">
                        <Ellipse
                            x:Name="IconBackground"
                            Width="44"
                            Height="44"
                            Fill="{DynamicResource MaterialDesign.Brush.Primary}"
                            Opacity="0.12" />
                        <materialDesign:PackIcon
                            x:Name="IconControl"
                            Width="24"
                            Height="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="InformationOutline" />
                    </Grid>

                    <TextBlock
                        x:Name="TitleText"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!--  Message body  -->
                <ScrollViewer
                    MaxHeight="200"
                    Margin="0,4,0,0"
                    VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        x:Name="MessageText"
                        FontSize="14"
                        Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                        LineHeight="22"
                        TextWrapping="Wrap" />
                </ScrollViewer>

                <!--  Footer separator  -->
                <Border
                    Height="1"
                    Margin="0,20,0,16"
                    Background="{DynamicResource MaterialDesign.Brush.Separator.Background}" />

                <!--  OK button  -->
                <Button
                    MinWidth="80"
                    HorizontalAlignment="Right"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                    Content="OK"
                    IsDefault="True"
                    Style="{StaticResource MaterialDesignFlatButton}" />

            </StackPanel>
        </Grid>
    </materialDesign:Card>
</views:DialogBase>
