<UserControl
    x:Class="SlnDependencyStudio.Wpf.Views.ConfirmDiscardDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:SlnDependencyStudio.Wpf.Models"
    xmlns:wpf="clr-namespace:SlnDependencyStudio.Wpf"
    d:DesignWidth="350"
    mc:Ignorable="d">

    <StackPanel Margin="16">
        <TextBlock
            x:Name="MessageText"
            Margin="0,0,0,16"
            FontSize="14"
            TextWrapping="Wrap" />

        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">

            <Button
                Margin="0,0,8,0"
                Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                CommandParameter="{x:Static models:DiscardAction.Save}"
                Content="Save"
                Style="{StaticResource MaterialDesignFlatButton}" />

            <Button
                Margin="0,0,8,0"
                Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                CommandParameter="{x:Static models:DiscardAction.Discard}"
                Content="Discard"
                Style="{StaticResource MaterialDesignOutlinedButton}" />

            <Button
                Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                CommandParameter="{x:Static models:DiscardAction.Cancel}"
                Content="Cancel"
                IsCancel="True" />
        </StackPanel>
    </StackPanel>
</UserControl>
