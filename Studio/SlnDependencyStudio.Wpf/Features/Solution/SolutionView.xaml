<reactiveui:ReactiveUserControl
    x:Class="SlnDependencyStudio.Wpf.Features.Solution.SolutionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:solution="clr-namespace:SlnDependencyStudio.Wpf.Features.Solution"
    xmlns:studioControls="clr-namespace:SlnDependencyStudio.Wpf.Controls"
    d:DesignHeight="400"
    d:DesignWidth="600"
    x:TypeArguments="solution:SolutionViewModel"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!--  Header  -->
            <StackPanel Margin="0,0,0,24" Orientation="Horizontal">
                <materialDesign:PackIcon
                    Width="28"
                    Height="28"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                    Kind="FolderOpenOutline" />
                <StackPanel>
                    <TextBlock
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                        Text="Solution" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                        Text="Solution and project filter settings" />
                </StackPanel>
            </StackPanel>

            <!--  Solution Path  -->
            <studioControls:FormField
                x:Name="SolutionPathFormField"
                Title="Solution path"
                Margin="0,0,0,24"
                Description="The relative or absolute path to the .sln or .slnx file.">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="0"
                        materialDesign:HintAssist.Hint="Path to .sln or .slnx file"
                        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                        Text="{Binding SolutionPath.Value, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        Command="{Binding BrowseSolutionPathCommand}"
                        Content="Browse"
                        Style="{StaticResource ActionButtonStyle}" />
                    <CheckBox
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="0,4,0,0"
                        VerticalAlignment="Center"
                        Content="Use relative path"
                        IsChecked="{Binding UseRelativePath.Value}" />
                </Grid>
            </studioControls:FormField>

            <!--  Regex-to-Include  -->
            <studioControls:FormField
                Title="Include patterns"
                Margin="0,0,0,24"
                Description="Regex patterns matching solution projects to include.">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            materialDesign:HintAssist.Hint="Regex pattern, e.g. .*\.csproj"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                            Text="{Binding RegexToIncludeInput.NewItemText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding RegexToIncludeInput.AddCommand}"
                            Content="Add"
                            Style="{StaticResource ActionButtonStyle}" />
                    </Grid>
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                        Text="{Binding RegexToIncludeInput.Error, TargetNullValue=''}"
                        TextWrapping="Wrap" />
                    <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding RegexToIncludeInput.Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <materialDesign:Chip
                                    Margin="0,0,6,6"
                                    Padding="8,2,12,2"
                                    Content="{Binding}"
                                    DeleteCommand="{Binding DataContext.RegexToIncludeInput.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    DeleteCommandParameter="{Binding}"
                                    IsDeletable="True" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </studioControls:FormField>

            <!--  Regex-to-Exclude  -->
            <studioControls:FormField
                Title="Exclude patterns"
                Margin="0,0,0,24"
                Description="Regex patterns matching solution projects to exclude.">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            materialDesign:HintAssist.Hint="Regex pattern, e.g. .*Tests\.csproj"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                            Text="{Binding RegexToExcludeInput.NewItemText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding RegexToExcludeInput.AddCommand}"
                            Content="Add"
                            Style="{StaticResource ActionButtonStyle}" />
                    </Grid>
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                        Text="{Binding RegexToExcludeInput.Error, TargetNullValue=''}"
                        TextWrapping="Wrap" />
                    <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding RegexToExcludeInput.Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <materialDesign:Chip
                                    Margin="0,0,6,6"
                                    Padding="8,2,12,2"
                                    Content="{Binding}"
                                    DeleteCommand="{Binding DataContext.RegexToExcludeInput.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    DeleteCommandParameter="{Binding}"
                                    IsDeletable="True" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </studioControls:FormField>

            <!--  Packages to Exclude  -->
            <studioControls:FormField
                Title="Packages to exclude"
                Margin="0,0,0,24"
                Description="Package IDs to exclude from diagram and summary output (case-insensitive).">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            materialDesign:HintAssist.Hint="Package ID, e.g. Microsoft.SourceLink.GitHub"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                            Text="{Binding PackagesToExcludeInput.NewItemText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding PackagesToExcludeInput.AddCommand}"
                            Content="Add"
                            Style="{StaticResource ActionButtonStyle}" />
                    </Grid>
                    <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding PackagesToExcludeInput.Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <materialDesign:Chip
                                    Margin="0,0,6,6"
                                    Padding="8,2,12,2"
                                    Content="{Binding}"
                                    DeleteCommand="{Binding DataContext.PackagesToExcludeInput.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    DeleteCommandParameter="{Binding}"
                                    IsDeletable="True" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </studioControls:FormField>

            <!--  Frameworks to Exclude  -->
            <studioControls:FormField
                Title="Frameworks to exclude"
                Margin="0,0,0,24"
                Description="Framework reference IDs to exclude from diagram and summary output (case-insensitive).">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            materialDesign:HintAssist.Hint="Framework ID, e.g. Microsoft.NetCore.App"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                            Text="{Binding FrameworksToExcludeInput.NewItemText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding FrameworksToExcludeInput.AddCommand}"
                            Content="Add"
                            Style="{StaticResource ActionButtonStyle}" />
                    </Grid>
                    <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding FrameworksToExcludeInput.Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <materialDesign:Chip
                                    Margin="0,0,6,6"
                                    Padding="8,2,12,2"
                                    Content="{Binding}"
                                    DeleteCommand="{Binding DataContext.FrameworksToExcludeInput.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    DeleteCommandParameter="{Binding}"
                                    IsDeletable="True" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </studioControls:FormField>

            <!--  Individual Scope  -->
            <studioControls:FormField
                Title="Individual scope"
                Margin="0,0,0,24"
                Description="Options for processing projects individually.">
                <Border
                    Padding="16,12"
                    Background="{DynamicResource MaterialDesign.Brush.Chip.Background}"
                    CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ToggleButton
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="0"
                            VerticalAlignment="Top"
                            IsChecked="{Binding IndividualEnabled.Value}"
                            Style="{StaticResource MaterialDesignSwitchToggleButton}" />

                        <CheckBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            Content="Include dependencies"
                            IsChecked="{Binding IndividualIncludeDependencies.Value}"
                            IsEnabled="{Binding IndividualEnabled.Value}" />
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="16,8,0,0"
                            IsEnabled="{Binding IndividualEnabled.Value}"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Text="Transitive depth" />
                            <TextBlock
                                Width="28"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding IndividualTransitiveDepth.Value}" />
                            <Slider
                                Width="200"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                IsSnapToTickEnabled="True"
                                Maximum="10"
                                Minimum="0"
                                TickFrequency="1"
                                Value="{Binding IndividualTransitiveDepth.Value}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </studioControls:FormField>

            <!--  All Scope  -->
            <studioControls:FormField
                Title="All scope"
                Margin="0,0,0,24"
                Description="Options for processing all projects collectively.">
                <Border
                    Padding="16,12"
                    Background="{DynamicResource MaterialDesign.Brush.Chip.Background}"
                    CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ToggleButton
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="0"
                            VerticalAlignment="Top"
                            IsChecked="{Binding AllEnabled.Value}"
                            Style="{StaticResource MaterialDesignSwitchToggleButton}" />

                        <CheckBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            Content="Include dependencies"
                            IsChecked="{Binding AllIncludeDependencies.Value}"
                            IsEnabled="{Binding AllEnabled.Value}" />
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="16,8,0,0"
                            IsEnabled="{Binding AllEnabled.Value}"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Text="Transitive depth" />
                            <TextBlock
                                Width="28"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding AllTransitiveDepth.Value}" />
                            <Slider
                                Width="200"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                IsSnapToTickEnabled="True"
                                Maximum="10"
                                Minimum="0"
                                TickFrequency="1"
                                Value="{Binding AllTransitiveDepth.Value}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </studioControls:FormField>

        </StackPanel>
    </ScrollViewer>
</reactiveui:ReactiveUserControl>
