<reactiveui:ReactiveUserControl
    x:Class="SlnDependencyStudio.Wpf.Features.Export.ExportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:export="clr-namespace:SlnDependencyStudio.Wpf.Features.Export"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:studioControls="clr-namespace:SlnDependencyStudio.Wpf.Controls"
    d:DesignHeight="400"
    d:DesignWidth="600"
    x:TypeArguments="export:ExportViewModel"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!--  Header  -->
            <StackPanel Margin="0,0,0,24" Orientation="Horizontal">
                <materialDesign:PackIcon
                    Width="28"
                    Height="28"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                    Kind="ExportVariant" />
                <StackPanel>
                    <TextBlock
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                        Text="Export" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                        Text="Export path and file format settings" />
                </StackPanel>
            </StackPanel>

            <!--  Export Root Path  -->
            <studioControls:FormField
                x:Name="ExportRootFormField"
                Title="Export root"
                Margin="0,0,0,24"
                Description="The root directory for generated diagram and image files.">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="0"
                        materialDesign:HintAssist.Hint="Path to export directory"
                        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                        Text="{Binding RootPath.Value, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource ActionButtonStyle}"
                        Command="{Binding BrowseExportPathCommand}"
                        Content="Browse" />
                    <CheckBox
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="0,4,0,0"
                        VerticalAlignment="Center"
                        Content="Use relative path"
                        IsChecked="{Binding UseRelativePath.Value}" />
                </Grid>
            </studioControls:FormField>

            <!--  Clear Output Folder  -->
            <studioControls:FormField
                Title="Clear output folder"
                Margin="0,0,0,24"
                Description="When enabled, existing output sub-folders are cleared before generating new files.">
                <ToggleButton
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsChecked="{Binding ClearContents.Value}"
                    Style="{StaticResource MaterialDesignSwitchToggleButton}" />
            </studioControls:FormField>

            <!--  Image Formats  -->
            <studioControls:FormField
                Title="Image formats"
                Margin="0,0,0,24"
                Description="The image formats to generate from diagram files.">
                <ItemsControl ItemsSource="{Binding ImageFormatToggles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox
                                MinWidth="140"
                                Margin="0,0,20,8"
                                VerticalAlignment="Center"
                                IsChecked="{Binding IsChecked}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Kind="{Binding IconKind}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="{Binding DisplayName}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </studioControls:FormField>

        </StackPanel>
    </ScrollViewer>
</reactiveui:ReactiveUserControl>
