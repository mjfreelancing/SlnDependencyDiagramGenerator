<reactiveui:ReactiveWindow
    x:Class="SlnDependencyStudio.Wpf.Features.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:settings="clr-namespace:SlnDependencyStudio.Wpf.Features.Settings"
    Title="Settings"
    Width="650"
    Height="480"
    MinWidth="450"
    MinHeight="400"
    x:TypeArguments="settings:SettingsWindowViewModel"
    Background="{DynamicResource MaterialDesign.Brush.Background}"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterOwner"
    WindowStyle="ToolWindow"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Settings content area — populated in code-behind via ContentControl  -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden">
            <ContentControl
                x:Name="SettingsContent"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch" />
        </ScrollViewer>

        <!--  Separator  -->
        <Separator
            Grid.Row="0"
            Margin="12,0"
            VerticalAlignment="Bottom" />

        <!--  Action Buttons  -->
        <Grid Grid.Row="1" Margin="12,8,12,12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Restart-required indicator — only visible when LogRetentionDays has been edited  -->
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Visibility="{Binding IsRestartRequired, Converter={StaticResource BoolToVis}}">

                <materialDesign:PackIcon
                    Width="16"
                    Height="16"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                    Kind="Restart" />

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                    Text="Restart required for log retention change" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">

                <Button
                    x:Name="CancelButton"
                    Margin="0,0,8,0"
                    Content="Cancel"
                    Style="{StaticResource MaterialDesignOutlinedButton}" />

                <Button
                    x:Name="SaveButton"
                    materialDesign:ButtonAssist.CornerRadius="8"
                    Content="Save"
                    Style="{StaticResource MaterialDesignFlatButton}" />
            </StackPanel>
        </Grid>
    </Grid>

</reactiveui:ReactiveWindow>
