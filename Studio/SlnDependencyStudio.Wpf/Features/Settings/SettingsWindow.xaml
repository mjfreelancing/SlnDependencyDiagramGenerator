<reactiveui:ReactiveWindow
    x:Class="SlnDependencyStudio.Wpf.Features.Settings.SettingsWindow"
    x:TypeArguments="settings:SettingsWindowViewModel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:settings="clr-namespace:SlnDependencyStudio.Wpf.Features.Settings"
    Title="Settings"
    Width="550"
    Height="450"
    MinWidth="450"
    MaxWidth="900"
    MinHeight="380"
    MaxHeight="380"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterOwner"
    WindowStyle="ToolWindow"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Settings content area — populated in code-behind via ContentControl -->
        <ContentControl
            x:Name="SettingsContent"
            Grid.Row="0"
            Margin="0,0,0,0" />

        <!-- Separator -->
        <Separator
            Grid.Row="0"
            VerticalAlignment="Bottom"
            Margin="12,0" />

        <!-- Action Buttons -->
        <Grid
            Grid.Row="1"
            Margin="12,8,12,12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Restart-required indicator — only visible when LogRetentionDays has been edited -->
            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Visibility="{Binding IsRestartRequired, Converter={StaticResource BoolToVis}}">

                <materialDesign:PackIcon
                    Kind="Restart"
                    Width="16" Height="16"
                    VerticalAlignment="Center"
                    Margin="0,0,6,0"
                    Foreground="{DynamicResource MaterialDesignHintForeground}" />

                <TextBlock
                    Text="Restart required for log retention change"
                    FontSize="11"
                    Foreground="{DynamicResource MaterialDesignHintForeground}"
                    VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal">

                <Button
                    x:Name="CancelButton"
                    Content="Cancel"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Margin="0,0,8,0" />

                <Button
                    x:Name="SaveButton"
                    Content="Save"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    materialDesign:ButtonAssist.CornerRadius="8" />
            </StackPanel>
        </Grid>
    </Grid>

</reactiveui:ReactiveWindow>
