<reactiveui:ReactiveUserControl
    x:Class="SlnDependencyStudio.Wpf.Features.Settings.SettingsEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:settings="clr-namespace:SlnDependencyStudio.Wpf.Features.Settings"
    d:DesignHeight="400"
    d:DesignWidth="500"
    x:TypeArguments="settings:SettingsEditorViewModel"
    mc:Ignorable="d">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  Header  -->
        <materialDesign:PackIcon
            Grid.Row="0"
            Grid.Column="0"
            Width="24"
            Height="24"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            Kind="Cog" />

        <TextBlock
            Grid.Row="0"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Margin="0,0,0,16"
            FontSize="18"
            FontWeight="SemiBold"
            Text="Application Settings" />

        <!--  Default Project Folder  -->
        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,0,12,8"
            VerticalAlignment="Center"
            FontSize="13"
            Text="Default project folder" />

        <TextBox
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,0,8,8"
            VerticalAlignment="Center"
            materialDesign:HintAssist.Hint="Leave empty for no default"
            Text="{Binding DefaultProjectFolder, UpdateSourceTrigger=PropertyChanged}" />

        <Button
            x:Name="BrowseDefaultProjectFolderButton"
            Grid.Row="1"
            Grid.Column="2"
            Margin="0,0,0,8"
            VerticalAlignment="Center"
            Content="{materialDesign:PackIcon FolderOpenOutline}"
            Style="{StaticResource MaterialDesignIconButton}"
            ToolTip="Browse for folder" />

        <!--  d2 Tool Path  -->
        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            Margin="0,0,12,8"
            VerticalAlignment="Center"
            FontSize="13"
            Text="d2 executable" />

        <TextBox
            Grid.Row="2"
            Grid.Column="1"
            Margin="0,0,8,8"
            VerticalAlignment="Center"
            materialDesign:HintAssist.Hint="Auto-detected if empty"
            Text="{Binding D2ToolPath, UpdateSourceTrigger=PropertyChanged}" />

        <Button
            x:Name="BrowseD2ToolPathButton"
            Grid.Row="2"
            Grid.Column="2"
            Margin="0,0,0,8"
            VerticalAlignment="Center"
            Content="{materialDesign:PackIcon FileSearchOutline}"
            Style="{StaticResource MaterialDesignIconButton}"
            ToolTip="Browse for d2 executable" />

        <!--  mmdc Tool Path  -->
        <TextBlock
            Grid.Row="3"
            Grid.Column="0"
            Margin="0,0,12,8"
            VerticalAlignment="Center"
            FontSize="13"
            Text="mmdc executable" />

        <TextBox
            Grid.Row="3"
            Grid.Column="1"
            Margin="0,0,8,8"
            VerticalAlignment="Center"
            materialDesign:HintAssist.Hint="Auto-detected if empty"
            Text="{Binding MmdcToolPath, UpdateSourceTrigger=PropertyChanged}" />

        <Button
            x:Name="BrowseMmdcToolPathButton"
            Grid.Row="3"
            Grid.Column="2"
            Margin="0,0,0,8"
            VerticalAlignment="Center"
            Content="{materialDesign:PackIcon FileSearchOutline}"
            Style="{StaticResource MaterialDesignIconButton}"
            ToolTip="Browse for mmdc executable" />

        <!--  Log Retention Days  -->
        <TextBlock
            Grid.Row="4"
            Grid.Column="0"
            Margin="0,0,12,8"
            VerticalAlignment="Center"
            FontSize="13"
            Text="Log retention (days)" />

        <Slider
            x:Name="LogRetentionDaysSlider"
            Grid.Row="4"
            Grid.Column="1"
            Margin="0,0,8,8"
            VerticalAlignment="Center"
            IsSnapToTickEnabled="True"
            Maximum="90"
            Minimum="1"
            TickFrequency="1"
            Value="{Binding LogRetentionDays}" />

        <TextBlock
            Grid.Row="4"
            Grid.Column="2"
            Margin="0,0,0,8"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{DynamicResource MaterialDesignHintForeground}"
            Text="{Binding LogRetentionDays, StringFormat={}{0} days}" />

        <!--  Spacer  -->
        <Border
            Grid.Row="5"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Height="16" />
    </Grid>

</reactiveui:ReactiveUserControl>
