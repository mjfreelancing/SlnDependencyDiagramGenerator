<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>Latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SlnDependencyStudio.Wpf</RootNamespace>
    <AssemblyName>SlnDependencyStudio.Wpf</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Phase 1: ReactiveUI foundation -->
    <PackageReference Include="ReactiveUI" />
    <PackageReference Include="ReactiveUI.Validation" />
    <PackageReference Include="ReactiveUI.Fody" />
    <PackageReference Include="ReactiveUI.WPF" />

    <!-- Phase 1: UI theming -->
    <PackageReference Include="MaterialDesignThemes" />

    <!-- Phase 1: AllOverIt infrastructure -->
    <PackageReference Include="AllOverIt.ReactiveUI" />
    <PackageReference Include="AllOverIt.ReactiveUI.Wpf" />
    <PackageReference Include="AllOverIt.DependencyInjection" />

    <!-- Phase 1: Hosting and logging -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.RollingFile" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Source\SlnDependencyDiagramGenerator.csproj" />
    <ProjectReference Include="..\SlnDependencyStudio.Shared\SlnDependencyStudio.Shared.csproj" />
  </ItemGroup>

</Project>
